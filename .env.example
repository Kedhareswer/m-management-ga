# All optional — the app runs with zero configuration.

# Neon Postgres (or any Postgres reachable by the Neon serverless driver).
# When set, the library and chat memory live in Postgres — required for
# hosts without a persistent disk (e.g. Vercel). Without it, storage falls
# back to a local JSON file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM providers — server-side secrets, never sent to the browser.
# Requesty router is preferred when REQUESTY_API_KEY is set; NVIDIA NIM is
# the fallback. The chat UI can still accept a session-only override key.
# REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
# NVIDIA_API_KEY=
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Where the library, chat memory and cover cache live.
DATA_DIR=./data

# Agent memory compaction thresholds.
MEMORY_MAX_MESSAGES=40
MEMORY_KEEP_RECENT=12

# Use a pre-installed Chromium for the Playwright extractor.
# CHROMIUM_PATH=/usr/bin/chromium

# Set to 1 to skip Playwright and use the lightweight extractor only.
# On Vercel, Playwright is auto-skipped (VERCEL=1) even if this is unset.
# DISABLE_PLAYWRIGHT=

# Politeness: minimum spacing (ms) between scrapes of the SAME host, so the
# app never hammers a site. Different hosts still run in parallel.
# SCRAPE_MIN_INTERVAL_MS=1500

# Optional: route extraction (Playwright + the plain-fetch fallback) through
# your own proxy — e.g. for a site you have legitimate access to that's
# geo-restricted or rate-limits this server's IP. Off by default.
# http(s)://user:pass@host:port or socks5://host:port
# SCRAPER_PROXY=

# TinyFish (via @tiny-fish/sdk) — powers two things:
#  1. web-search recommendations beyond your shelf ("recommend isekai")
#  2. rescuing metadata from bot-protected sites (their fetcher, not our IP)
# Server-side secret — never sent to the browser. Without it, both features
# are simply absent. Key from https://agent.tinyfish.ai/api-keys
# TINYFISH_API_KEY=
# Base URL override is only for local mocks; the SDK default is agent.tinyfish.ai
# TINYFISH_BASE_URL=
