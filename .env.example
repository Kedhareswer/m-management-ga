# All optional — the app runs with zero configuration.

# Default LLM model for Mango when a Requesty key is provided in the chat UI.
# (The key itself is session-based: pasted in the chat settings, never stored.)
AI_MODEL=google/gemma-4-31b-it

# Override the Requesty router endpoint (OpenAI-compatible).
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Where the library, chat memory and cover cache live.
DATA_DIR=./data

# Agent memory compaction thresholds.
MEMORY_MAX_MESSAGES=40
MEMORY_KEEP_RECENT=12

# Use a pre-installed Chromium for the Playwright extractor.
# CHROMIUM_PATH=/usr/bin/chromium

# Set to 1 to skip Playwright and use the lightweight extractor only.
# DISABLE_PLAYWRIGHT=
